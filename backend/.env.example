# ==============================================================================
# QWEN WEB-CHATS BACKEND CONFIGURATION (.env)
# Sesi dan Kredensial Resmi Qwen Desktop (Diekstrak via MCP REA)
# ==============================================================================

# 1. SERVER CONFIGURATION
PORT=3004
NODE_ENV=development

# 2. ALIBABA CLOUD QWEN / DASHSCOPE & WEB ENDPOINTS
# DashScope OpenAI-Compatible Base URL (International / Global)
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_WEB_CHAT_API_URL=https://chat.qwen.ai/api
QWEN_OFFICIAL_WEB_URL=https://chat.qwen.ai

# 3. KREDENSIAL SESI RESMI QWEN DESKTOP (AKUN AKTIF)
# User ID Akun Qwen: 6d9330ea-83f2-4a69-af62-34c88c685ffd
QWEN_USER_ID=
QWEN_DEVICE_ID=
QWEN_CNA=

# Token Akses Aktif (Bearer JWT Token)
QWEN_ACCESS_TOKEN=

# Refresh Token Persisten (Masa Berlaku hingga 2027)
QWEN_REFRESH_TOKEN=

# Master Key Enkripsi DPAPI (AES-256-GCM 32-Byte)
QWEN_MASTER_KEY_HEX=

# String Header Cookie Lengkap (Hasil Dekripsi Chromium SQLite Cookies)
QWEN_COOKIE_HEADER=""

# 4. INSTALASI QWEN DESKTOP LOKAL (OPSIONAL - TIDAK WAJIB)
# QWEN_APP_PATH="C:\Users\robyk\AppData\Local\Programs\Qwen\Qwen.exe"
# QWEN_DATA_PATH="C:\Users\robyk\AppData\Roaming\Qwen"
# 5. KREDENSIAL API DASHSCOPE (OPSIONAL CLOUD DEVELOPER)
DASHSCOPE_API_KEY=

# 6. DEFAULT MODEL & INFERENCE SETTINGS
DEFAULT_QWEN_MODEL=qwen-3.8-max
QWEN_REASONING_EFFORT=medium
QWEN_TEMPERATURE=0.7
QWEN_MAX_OUTPUT_TOKENS=8192
