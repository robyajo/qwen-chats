# ==============================================================================
# ANTIGRAVITY QWEN-CHATS - FRONTEND CONFIGURATION TEMPLATE (.env.example)
# Salin berkas ini menjadi .env untuk konfigurasi lokal Anda:
#   cp .env.example .env
# ==============================================================================

# 1. DEVELOPMENT SERVER & PROXY CONFIGURATION
# Port server dev Vite untuk antarmuka frontend
VITE_PORT=5174

# Port & URL target backend Express lokal (untuk proxy Vite)
BACKEND_PORT=3004
BACKEND_URL=http://localhost:3004

# 2. CLIENT-SIDE API ENDPOINTS & BRIDGE PATHS
# Base path internal API (diproyeksikan melalui proxy Vite)
VITE_API_BASE_URL=/api

# Base path OpenAI-compatible bridge untuk integrasi chat completions
VITE_OPENAI_BRIDGE_URL=/v1

# Path menuju Web Dashboard & Playground pengujian bridge
VITE_BRIDGE_DASHBOARD_URL=/bridge

# 3. IDENTITAS & DEFAULT MODEL APLIKASI
VITE_APP_TITLE="Antigravity Qwen-Chats"
VITE_APP_VERSION="1.0.4"

# Model default saat pertama kali memuat antarmuka (qwen-3.7-plus / qwen-3.8-max)
VITE_DEFAULT_MODEL="qwen-3.7-plus"

# Tingkat penalaran / thinking mode default (low, medium, high, auto)
VITE_DEFAULT_REASONING_EFFORT="medium"

# Kecepatan pengetikan fallback streaming (milidetik per token)
VITE_DEFAULT_STREAM_SPEED=35
